    <!-- Titres et durées YouTube (oEmbed + page de la vidéo) lus par le
         serveur. L'administrateur doit accepter une fois, dans la console :
             aclrequest allow CarPlay all
         Sans cela la musique marche quand même (titre « Vidéo YouTube … »,
         pas de passage automatique au morceau suivant). -->
    <aclrequest>
        <right name="function.fetchRemote" access="true" />
    </aclrequest>

    <!-- Le lecteur YouTube intégré a besoin d'un client MTA récent (1.6.x à
         jour : correctif Referer #4531). Pas de min_mta_version pour ne
         bloquer personne : un vieux client verra « Erreur 153 » sur la vidéo. -->
    <oop>false</oop>
