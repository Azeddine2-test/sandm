<meta>
    <info author="Arena (demande 69)" name="CarPlay" version="1.0.0" type="script"
          description="CarPlay dans les véhicules : musique YouTube / liens audio synchronisée pour tous, file d'attente, favoris, Plans, Téléphone et Messages de l'iPhone." />

    <!-- Demande 69 (20/10/2026). Ouverture : clic droit sur le véhicule →
         « CarPlay » (menu i9_interaction), place avant, iPhone requis.
         Démarre APRÈS PhoneIOS ([ST]-StartAll). -->
    <script src="config.lua" type="shared" cache="false" />
    <script src="liens.lua" type="shared" cache="false" />
    <script src="server.lua" type="server" />
    <script src="retour.lua" type="client" cache="false" />
    <script src="dessin.lua" type="client" cache="false" />
    <script src="audio.lua" type="client" cache="false" />
    <script src="acoustique.lua" type="client" cache="false" />
    <script src="client.lua" type="client" cache="false" />

    <export function="installCarPlayFromMechanic" type="server" />
    <export function="uninstallCarPlayFromMechanic" type="server" />
    <!-- Demande 91 : purge CarPlay d'un véhicule racheté neuf (appelé par le concessionnaire) -->
    <export function="carplaySupprimerInstallation" type="server" />
    <!-- Demande 112 : panneau Acoustique (i9 → Staff → Qualité audio, via admin_panel) -->
    <export function="ouvrirAcoustique" type="server" />
